# Public market data requires no exchange key. Do not put exchange credentials here.
TIDEBENCH_DATA_DIR=./data
TIDEBENCH_REGION=global
TIDEBENCH_AUTH_ENABLED=true
# Required for first setup through Docker or a remote connection (at least 32 random characters).
TIDEBENCH_BOOTSTRAP_TOKEN=
# Optional admin service token for automation. Leave empty for password-only access.
TIDEBENCH_API_TOKEN=
# Enable behind HTTPS. Keep false for the supplied localhost HTTP preview.
TIDEBENCH_COOKIE_SECURE=false
TIDEBENCH_SESSION_HOURS=12
TIDEBENCH_IDLE_MINUTES=30
TIDEBENCH_BACKUP_RETENTION=14
TIDEBENCH_ALLOWED_HOSTS=localhost,127.0.0.1
TIDEBENCH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

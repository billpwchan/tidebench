# No exchange API keys are needed or accepted by this release.
TIDEBENCH_DATA_DIR=./data
TIDEBENCH_REGION=global
# Optional for a local-only desk. Required before exposing the service remotely.
# Generate a long random value; never commit your .env file.
TIDEBENCH_API_TOKEN=
TIDEBENCH_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TIDEBENCH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
